	"type": "module",
	"scripts": {
		"dev": "node node_modules/vite/bin/vite.js dev",
		"build": "node node_modules/vite/bin/vite.js build",
		"preview": "node node_modules/vite/bin/vite.js preview",
		"prepare": "node node_modules/@sveltejs/kit/svelte-kit.js sync || echo ''",
		"check": "node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "node node_modules/drizzle-kit/bin.cjs push",
		"db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node node_modules/drizzle-kit/bin.cjs migrate",
		"db:studio": "node node_modules/drizzle-kit/bin.cjs studio"
	},
	"devDependencies": {
		"@libsql/client": "^0.17.3",
		"@skeletonlabs/skeleton": "^5.0.0",
