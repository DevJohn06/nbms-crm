		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/papaparse": "^5.5.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^1.0.1",
