	const page8 = pdfDoc.addPage([612, 792]);
	drawHeader(page8);

	page8.drawText('TERMINAL PRICES/ SPECS', {
		x: 180,
		y: 670,
		size: 16,
		font: fontBold,
		color: lightBlue
	});

	let p8y = 610;

	// DESK/3500
	page8.drawText('DESK/3500', { x: 310, y: p8y + 20, size: 16, font: fontBold, color: darkBlue });
	page8.drawText('$290', { x: 180, y: p8y + 20, size: 18, font: fontBold, color: textColor });
	page8.drawText('Standard Counter Top Terminal', { x: 310, y: p8y, size: 11, font: fontBold, color: rgb(0.85, 0.35, 0.1) });

	page8.drawText(`*Price includes programming, encryption, and shipping.  Quantity:  ${desk3500Qty}`, {
		x: 180,
		y: p8y - 15,
		size: 8.5,
		font: fontRegular,
		color: grayText
	});

	const deskSpecs = [
		'• Built in Printer',
		'• EMV Chip Compatible',
		'• Ethernet/WiFi Connectivity',
		'• 2.8" QVGA Display',
		'• Compatible with IPP315 Pin Pad'
	];
	let specY = p8y - 30;
	for (const sp of deskSpecs) {
		page8.drawText(sp, { x: 310, y: specY, size: 8.5, font: fontRegular, color: textColor });
		specY -= 11;
	}

	p8y -= 130;

	// MOVE/5000
	page8.drawText('MOVE/5000', { x: 310, y: p8y + 20, size: 16, font: fontBold, color: darkBlue });
	page8.drawText('$555 *WIFI only*', { x: 170, y: p8y + 20, size: 12, font: fontBold, color: textColor });
	page8.drawText('$620 *WIFI/4G*', { x: 170, y: p8y + 5, size: 12, font: fontBold, color: textColor });

	page8.drawText('Mobile Terminal', { x: 310, y: p8y, size: 11, font: fontBold, color: rgb(0.85, 0.35, 0.1) });
	page8.drawText(`Quantity (WIFI): ${move5000WifiQty}  |  Quantity (4G): ${move50004gQty}`, {
		x: 170,
		y: p8y - 12,
		size: 8.5,
		font: fontRegular,
		color: grayText
	});

	const moveSpecs = [
		'• Built in Printer',
		'• EMV Chip Compatible',
		'• WiFi or 4G/LTE Connectivity',
		'• 3.5" QVGA Display'
	];
	specY = p8y - 28;
	for (const sp of moveSpecs) {
		page8.drawText(sp, { x: 310, y: specY, size: 8.5, font: fontRegular, color: textColor });
		specY -= 11;
	}

	p8y -= 130;

	// DESK 1500 PIN PAD
	page8.drawText('Desk 1500 Pin Pad', { x: 310, y: p8y + 20, size: 16, font: fontBold, color: darkBlue });
	page8.drawText('$225', { x: 180, y: p8y + 20, size: 18, font: fontBold, color: textColor });
	page8.drawText('External Pin Pad', { x: 310, y: p8y, size: 11, font: fontBold, color: rgb(0.85, 0.35, 0.1) });

	page8.drawText(`Quantity:  ${desk1500PinPadQty}`, { x: 180, y: p8y - 12, size: 8.5, font: fontRegular, color: grayText });

	const padSpecs = [
		'• EMV Chip Compatible',
		'• Compatible with Desk 3500',
		'• USB Powered',
		'• 2.8" QVGA Display'
	];
	specY = p8y - 28;
	for (const sp of padSpecs) {
		page8.drawText(sp, { x: 310, y: specY, size: 8.5, font: fontRegular, color: textColor });
		specY -= 11;
	}

	drawFooter(page8, 8, false);

	// -------------------------------------------------------------
	// PAGE 9: ACH Bank Authorization Form
	// -------------------------------------------------------------
	const page9 = pdfDoc.addPage([612, 792]);
	drawHeader(page9);

	page9.drawText('ACH Bank Authorization Form', {
		x: 160,
		y: 670,
		size: 16,
		font: fontBold,
		color: lightBlue
	});

	let p9y = 630;
	const achIntro = [
		'This agreement entered by and between the parties whose signatures appears below agrees to this ACH processing agreement',
		'between PP, LLC Payment ("Processor") and ("Customer/Merchant"). The Customer enters into an agreement with Processor',
		'to process Customer\'s ATM/EFT disbursements, debits, and deposits through the Automated Clearing House (ACH) system.'
	];
	for (const line of achIntro) {
		page9.drawText(line, { x: 40, y: p9y, size: 8, font: fontRegular, color: textColor });
		p9y -= 11.5;
	}
	p9y -= 15;

	// Bank Account Table Header
	page9.drawRectangle({
		x: 40,
		y: p9y - 18,
		width: 532,
		height: 22,
		color: lightBlue
	});

	page9.drawText('Account Name', { x: 50, y: p9y - 12, size: 9, font: fontBold, color: rgb(1, 1, 1) });
	page9.drawText('Routing #', { x: 210, y: p9y - 12, size: 9, font: fontBold, color: rgb(1, 1, 1) });
	page9.drawText('Account #', { x: 340, y: p9y - 12, size: 9, font: fontBold, color: rgb(1, 1, 1) });
	page9.drawText('Type', { x: 480, y: p9y - 12, size: 9, font: fontBold, color: rgb(1, 1, 1) });

	p9y -= 20;

	// Bank Account Data Row
	page9.drawRectangle({
		x: 40,
		y: p9y - 25,
		width: 532,
		height: 25,
		borderColor: borderGray,
		borderWidth: 1,
		color: lightBg
	});

	page9.drawText(bankAccountName, { x: 50, y: p9y - 16, size: 9, font: fontRegular, color: textColor });
	page9.drawText(bankRouting, { x: 210, y: p9y - 16, size: 9, font: fontRegular, color: textColor });
	page9.drawText(bankAccountNumber, { x: 340, y: p9y - 16, size: 9, font: fontRegular, color: textColor });
	page9.drawText(bankAccountType, { x: 480, y: p9y - 16, size: 9, font: fontRegular, color: textColor });

	p9y -= 45;

	page9.drawText('Please include a voided check or authorized bank letter as proof of valid and active account.', {
		x: 40,
		y: p9y,
		size: 8.5,
		font: fontOblique,
		color: grayText
	});

	p9y -= 40;
	page9.drawText(`Print Name:  ${clientName}`, { x: 40, y: p9y, size: 9.5, font: fontBold, color: textColor });

	p9y -= 45;
	if (embeddedSigImage) {
		page9.drawImage(embeddedSigImage, {
			x: 160,
			y: p9y - 5,
			width: 140,
			height: 40
		});
	}
	page9.drawLine({ start: { x: 40, y: p9y }, end: { x: 340, y: p9y }, thickness: 1, color: textColor });
	page9.drawText('Authorized Signature', { x: 40, y: p9y - 12, size: 8.5, font: fontOblique, color: grayText });

	p9y -= 45;
	page9.drawText(`Agreement Date:  ${todayStr}`, { x: 40, y: p9y, size: 9.5, font: fontBold, color: textColor });

	drawFooter(page9, 9, false);

	const pdfBytes = await pdfDoc.save();

	// Ensure output directory exists
	const storageDir = path.join(process.cwd(), 'static', 'contracts');
	await fs.mkdir(storageDir, { recursive: true });

	const fileName = `${contractId}.pdf`;
	const filePath = path.join(storageDir, fileName);
	await fs.writeFile(filePath, pdfBytes);

	let publicPdfUrl = `/contracts/${fileName}`;
	try {
		const r2Result = await uploadToR2({
			key: `contracts/${fileName}`,
			body: Buffer.from(pdfBytes),
			contentType: 'application/pdf'
		});
		if (r2Result.url) {
			publicPdfUrl = r2Result.url;
		}
	} catch (r2Err) {
		console.warn('[R2 Contract Upload Warning] R2 credentials not set or upload failed, using local storage fallback:', r2Err);
	}

	const now = new Date().toISOString();
	const isSigned = Boolean(signatureData || existingContract?.signatureData);
	const status = isSigned ? 'SIGNED' : 'PENDING_SIGNATURE';
	const signedAt = isSigned ? (existingContract?.signedAt || now) : null;

	// Save or update contract record in database
	const [updatedContract] = await db
		.insert(contracts)
		.values({
			id: contractId,
			leadId,
			clientName,
			clientEmail,
			servicePackage,
			monthlyFee,
			contractTerms,
			signatureData: signatureData || existingContract?.signatureData || null,
			pdfPath: publicPdfUrl,
			status,
			createdAt: now,
			signedAt
		})
		.onConflictDoUpdate({
			target: contracts.id,
			set: {
				clientName,
				clientEmail,
				servicePackage,
				monthlyFee,
				contractTerms,
				signatureData: signatureData || existingContract?.signatureData || null,
				pdfPath: publicPdfUrl,
				status,
				signedAt
			}
		})
		.returning();

	// Update lead status to CONTRACT_SIGNED if signed, or CONTRACT_SENT if pending signature
	await db
		.update(leads)
		.set({
			status: isSigned ? 'CONTRACT_SIGNED' : 'CONTRACT_SENT',
			updatedAt: now
		})
		.where(eq(leads.id, leadId));

	return { contract: updatedContract, pdfBytes, pdfUrl: publicPdfUrl };
}
